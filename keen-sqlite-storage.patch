diff --git a/storage/db.js b/storage/db.js
new file mode 100644
index 0000000..1eef080
--- /dev/null
+++ b/storage/db.js
@@ -0,0 +1,201 @@
+'use strict';
+const fs = require('fs');
+const path = require('path');
+const Database = require('better-sqlite3');
+
+// Each entry is one schema version. Append new entries; never edit old ones.
+// PRAGMA user_version tracks how many have been applied.
+const MIGRATIONS = [
+  `
+  CREATE TABLE projects (
+    id          INTEGER PRIMARY KEY,
+    name        TEXT NOT NULL UNIQUE COLLATE NOCASE,
+    color       TEXT,
+    archived    INTEGER NOT NULL DEFAULT 0,
+    created_at  TEXT NOT NULL DEFAULT (datetime('now'))
+  );
+
+  CREATE TABLE tasks (
+    id            INTEGER PRIMARY KEY,
+    title         TEXT NOT NULL,
+    project_id    INTEGER REFERENCES projects(id) ON DELETE SET NULL,
+    task_date     TEXT NOT NULL,                       -- local day, YYYY-MM-DD
+    status        TEXT NOT NULL DEFAULT 'todo'
+                  CHECK (status IN ('todo','doing','done','blocked')),
+    progress      INTEGER NOT NULL DEFAULT 0 CHECK (progress BETWEEN 0 AND 100),
+    estimate_min  INTEGER,
+    actual_min    INTEGER NOT NULL DEFAULT 0,
+    notes         TEXT,
+    sort_order    INTEGER NOT NULL DEFAULT 0,
+    created_at    TEXT NOT NULL DEFAULT (datetime('now')),
+    updated_at    TEXT NOT NULL DEFAULT (datetime('now')),
+    completed_at  TEXT,
+    deleted_at    TEXT                                  -- soft delete, enables undo
+  );
+  CREATE INDEX idx_tasks_date         ON tasks(task_date);
+  CREATE INDEX idx_tasks_project_date ON tasks(project_id, task_date);
+
+  CREATE TABLE time_entries (
+    id          INTEGER PRIMARY KEY,
+    task_id     INTEGER NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
+    started_at  TEXT NOT NULL,
+    ended_at    TEXT,
+    minutes     INTEGER NOT NULL DEFAULT 0
+  );
+  CREATE INDEX idx_time_entries_task ON time_entries(task_id);
+  `,
+];
+
+function migrate(db, file) {
+  const current = db.pragma('user_version', { simple: true });
+  if (current >= MIGRATIONS.length) return;
+  if (current > 0 && fs.existsSync(file)) {
+    db.pragma('wal_checkpoint(TRUNCATE)');
+    fs.copyFileSync(file, `${file}.pre-v${current}.bak`);
+  }
+  for (let v = current; v < MIGRATIONS.length; v++) {
+    db.transaction(() => {
+      db.exec(MIGRATIONS[v]);
+      db.pragma(`user_version = ${v + 1}`);
+    })();
+  }
+}
+
+function openDb(dir) {
+  fs.mkdirSync(dir, { recursive: true });
+  const file = path.join(dir, 'tracker.db');
+  const db = new Database(file);
+  db.pragma('journal_mode = WAL');
+  db.pragma('foreign_keys = ON');
+  migrate(db, file);
+  return db;
+}
+
+// "90", "45m", "1h", "1.5h", "1h30" -> minutes
+function parseMinutes(input) {
+  if (input == null || input === '') return 0;
+  if (typeof input === 'number') return Math.max(0, Math.round(input));
+  const s = String(input).trim().toLowerCase();
+  let m = s.match(/^(\d+(?:\.\d+)?)\s*h(?:ours?|rs?)?\s*(?:(\d+)\s*m?(?:in)?)?$/);
+  if (m) return Math.round(parseFloat(m[1]) * 60 + (m[2] ? parseInt(m[2], 10) : 0));
+  m = s.match(/^(\d+)\s*m(?:in(?:s|utes)?)?$/);
+  if (m) return parseInt(m[1], 10);
+  if (/^\d+(\.\d+)?$/.test(s)) return Math.round(parseFloat(s));
+  return 0;
+}
+
+const UPDATABLE = ['title', 'status', 'progress', 'estimate_min', 'actual_min', 'notes', 'task_date', 'sort_order'];
+
+function createRepo(db) {
+  const upsertProject = db.prepare(
+    `INSERT INTO projects(name) VALUES (?)
+     ON CONFLICT(name) DO UPDATE SET archived = archived
+     RETURNING id`
+  );
+  const projectId = (name) => (name && String(name).trim() ? upsertProject.get(String(name).trim()).id : null);
+
+  const selectTask = db.prepare(
+    `SELECT t.*, p.name AS project FROM tasks t
+     LEFT JOIN projects p ON p.id = t.project_id WHERE t.id = ?`
+  );
+  const insertTask = db.prepare(
+    `INSERT INTO tasks (title, project_id, task_date, status, progress, estimate_min, actual_min, notes, sort_order, created_at, completed_at)
+     VALUES (@title, @project_id, @task_date, @status, @progress, @estimate_min, @actual_min, @notes,
+             (SELECT COALESCE(MAX(sort_order), 0) + 1 FROM tasks WHERE task_date = @task_date),
+             COALESCE(@created_at, datetime('now')),
+             CASE WHEN @status = 'done' THEN COALESCE(@created_at, datetime('now')) END)`
+  );
+
+  const getTask = (id) => selectTask.get(id);
+
+  function addTask(input) {
+    const title = String(input.title || '').trim();
+    if (!title) throw new Error('Task title is required');
+    const status = input.status || 'todo';
+    const info = insertTask.run({
+      title,
+      project_id: projectId(input.project),
+      task_date: input.task_date,
+      status,
+      progress: status === 'done' ? 100 : input.progress || 0,
+      estimate_min: input.estimate_min ?? null,
+      actual_min: parseMinutes(input.minutes ?? input.actual_min),
+      notes: input.notes ?? null,
+      created_at: input.created_at ?? null,
+    });
+    return getTask(info.lastInsertRowid);
+  }
+
+  function updateTask(id, patch) {
+    const sets = [];
+    const params = { id };
+    for (const f of UPDATABLE) {
+      if (f in patch) { sets.push(`${f} = @${f}`); params[f] = patch[f]; }
+    }
+    if ('project' in patch) { sets.push('project_id = @project_id'); params.project_id = projectId(patch.project); }
+    if (patch.status) {
+      sets.push(`completed_at = CASE WHEN @status = 'done' THEN COALESCE(completed_at, datetime('now')) ELSE NULL END`);
+      if (patch.status === 'done' && !('progress' in patch)) { sets.push('progress = 100'); }
+    }
+    if (!sets.length) return getTask(id);
+    sets.push(`updated_at = datetime('now')`);
+    db.prepare(`UPDATE tasks SET ${sets.join(', ')} WHERE id = @id`).run(params);
+    return getTask(id);
+  }
+
+  const listTasksByDate = db.prepare(
+    `SELECT t.*, p.name AS project FROM tasks t
+     LEFT JOIN projects p ON p.id = t.project_id
+     WHERE t.task_date = ? AND t.deleted_at IS NULL ORDER BY t.sort_order, t.id`
+  );
+  const listAllTasks = db.prepare(
+    `SELECT t.*, p.name AS project FROM tasks t
+     LEFT JOIN projects p ON p.id = t.project_id
+     WHERE t.deleted_at IS NULL ORDER BY t.task_date, t.sort_order, t.id`
+  );
+  const softDelete = db.prepare(`UPDATE tasks SET deleted_at = datetime('now') WHERE id = ?`);
+  const undelete = db.prepare(`UPDATE tasks SET deleted_at = NULL WHERE id = ?`);
+
+  // Analytics. All take inclusive YYYY-MM-DD bounds.
+  const weekSummary = db.prepare(
+    `SELECT COALESCE(p.name, 'No project') AS project,
+            COUNT(*) AS tasks,
+            SUM(t.status = 'done') AS done,
+            SUM(t.actual_min) AS minutes
+     FROM tasks t LEFT JOIN projects p ON p.id = t.project_id
+     WHERE t.task_date BETWEEN ? AND ? AND t.deleted_at IS NULL
+     GROUP BY p.id ORDER BY minutes DESC`
+  );
+  const dailyTotals = db.prepare(
+    `SELECT task_date AS day, COUNT(*) AS tasks, SUM(status = 'done') AS done, SUM(actual_min) AS minutes
+     FROM tasks WHERE task_date BETWEEN ? AND ? AND deleted_at IS NULL
+     GROUP BY task_date ORDER BY task_date`
+  );
+  const monthlyTrend = db.prepare(
+    `SELECT strftime('%Y-%m', task_date) AS month, COUNT(*) AS tasks, SUM(status = 'done') AS done, SUM(actual_min) AS minutes
+     FROM tasks WHERE task_date BETWEEN ? AND ? AND deleted_at IS NULL
+     GROUP BY month ORDER BY month`
+  );
+  const projectProgress = db.prepare(
+    `SELECT p.id, p.name, COUNT(t.id) AS tasks, COALESCE(SUM(t.status = 'done'), 0) AS done,
+            COALESCE(ROUND(AVG(t.progress)), 0) AS progress, COALESCE(SUM(t.actual_min), 0) AS minutes
+     FROM projects p LEFT JOIN tasks t ON t.project_id = p.id AND t.deleted_at IS NULL
+     WHERE p.archived = 0 GROUP BY p.id ORDER BY p.name`
+  );
+
+  return {
+    addTask,
+    updateTask,
+    getTask,
+    listTasksByDate: (date) => listTasksByDate.all(date),
+    listAllTasks: () => listAllTasks.all(),
+    deleteTask: (id) => { softDelete.run(id); return { id }; },
+    undoDelete: (id) => { undelete.run(id); return getTask(id); },
+    listProjects: () => projectProgress.all(),
+    weekSummary: (from, to) => weekSummary.all(from, to),
+    dailyTotals: (from, to) => dailyTotals.all(from, to),
+    monthlyTrend: (from, to) => monthlyTrend.all(from, to),
+  };
+}
+
+module.exports = { openDb, createRepo, parseMinutes, MIGRATIONS };
diff --git a/storage/ipc.js b/storage/ipc.js
new file mode 100644
index 0000000..d5bdd66
--- /dev/null
+++ b/storage/ipc.js
@@ -0,0 +1,55 @@
+'use strict';
+const { parseMinutes } = require('./db');
+
+const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
+
+// Maps a database row to the shape the current renderer already uses.
+function toView(row) {
+  return {
+    id: String(row.id),
+    date: row.task_date,
+    title: row.title,
+    tag: row.project || '',
+    mins: row.actual_min,
+    status: row.status,
+    created: Date.parse(row.created_at.replace(' ', 'T') + 'Z'),
+  };
+}
+
+function registerIpc(ipcMain, repo) {
+  ipcMain.handle('tasks:load', () => {
+    const out = {};
+    for (const row of repo.listAllTasks()) out[row.id] = toView(row);
+    return out;
+  });
+
+  // Creates when the id is not a database id yet (the renderer invents "t…" ids), otherwise updates.
+  ipcMain.handle('tasks:save', (_event, t) => {
+    if (!t || typeof t.title !== 'string' || !t.title.trim()) throw new Error('Task title is required');
+    if (!DATE_RE.test(String(t.date))) throw new Error('Invalid task date');
+    const id = String(t.id);
+    if (/^\d+$/.test(id) && repo.getTask(Number(id))) {
+      return toView(repo.updateTask(Number(id), {
+        title: t.title.trim(),
+        project: t.tag || null,
+        actual_min: parseMinutes(t.mins),
+        status: t.status,
+        task_date: t.date,
+      }));
+    }
+    return toView(repo.addTask({
+      title: t.title,
+      project: t.tag,
+      minutes: t.mins,
+      status: t.status,
+      task_date: t.date,
+    }));
+  });
+
+  ipcMain.handle('tasks:remove', (_event, id) => {
+    repo.deleteTask(Number(id));
+    return true;
+  });
+}
+
+module.exports = { registerIpc, toView };
diff --git a/storage/migrate-json.js b/storage/migrate-json.js
new file mode 100644
index 0000000..bd40662
--- /dev/null
+++ b/storage/migrate-json.js
@@ -0,0 +1,53 @@
+'use strict';
+const fs = require('fs');
+
+const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
+const STATUSES = new Set(['todo', 'doing', 'done', 'blocked']);
+
+// Keen's tasks.json is an object keyed by task id:
+//   { "t1abc": { id, date: "2026-11-02", title, tag, mins, status, created: 1730000000000 }, ... }
+// Arrays and { tasks: [...] } are also accepted.
+function flatten(raw) {
+  if (Array.isArray(raw)) return raw;
+  if (raw && Array.isArray(raw.tasks)) return raw.tasks;
+  if (raw && typeof raw === 'object') return Object.values(raw).filter((v) => v && typeof v === 'object');
+  return [];
+}
+
+function toSqlTime(ms) {
+  return Number.isFinite(ms) ? new Date(ms).toISOString().slice(0, 19).replace('T', ' ') : null;
+}
+
+function normalise(t) {
+  const title = typeof t.title === 'string' ? t.title.trim() : '';
+  const date = typeof t.date === 'string' && DATE_RE.test(t.date) ? t.date : null;
+  if (!title || !date) return null;
+  const status = STATUSES.has(t.status) ? t.status : 'todo';
+  return {
+    title,
+    task_date: date,
+    project: t.tag || null,
+    minutes: Number(t.mins) || 0,
+    status,
+    created: Number(t.created) || 0,
+    created_at: toSqlTime(Number(t.created)),
+  };
+}
+
+// Returns { found, imported, skipped }. The source file is renamed, never deleted.
+function importLegacyJson(db, repo, jsonPath) {
+  if (!fs.existsSync(jsonPath)) return { found: false, imported: 0, skipped: 0 };
+  const raw = JSON.parse(fs.readFileSync(jsonPath, 'utf8'));
+  const rows = flatten(raw).map(normalise);
+  const good = rows.filter(Boolean).sort((a, b) => a.created - b.created);
+  const skipped = rows.length - good.length;
+
+  db.transaction(() => {
+    for (const r of good) repo.addTask(r);
+  })();
+
+  fs.renameSync(jsonPath, `${jsonPath}.migrated`);
+  return { found: true, imported: good.length, skipped };
+}
+
+module.exports = { importLegacyJson };
diff --git a/test/storage.test.js b/test/storage.test.js
new file mode 100644
index 0000000..285ea91
--- /dev/null
+++ b/test/storage.test.js
@@ -0,0 +1,54 @@
+// Run with Electron's Node so the native module matches (see README):
+//   PowerShell: $env:ELECTRON_RUN_AS_NODE=1; npx electron test\storage.test.js
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const assert = require('assert');
+const { openDb, createRepo, parseMinutes } = require('../storage/db');
+const { importLegacyJson } = require('../storage/migrate-json');
+const { registerIpc } = require('../storage/ipc');
+
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'ttm-'));
+const db = openDb(dir);
+const repo = createRepo(db);
+
+// schema + parser
+assert.strictEqual(db.pragma('user_version', { simple: true }), 1);
+[['90', 90], ['45m', 45], ['1h', 60], ['1.5h', 90], ['1h30', 90], ['', 0]].forEach(([s, m]) => assert.strictEqual(parseMinutes(s), m));
+
+// legacy import in the exact shape the old renderer wrote
+const t0 = Date.UTC(2026, 10, 2, 9, 0, 0);
+const legacy = path.join(dir, 'tasks.json');
+fs.writeFileSync(legacy, JSON.stringify({
+  tb: { id: 'tb', date: '2026-11-02', title: 'Second', tag: 'Alpha', mins: 30, status: 'blocked', created: t0 + 5000 },
+  ta: { id: 'ta', date: '2026-11-02', title: 'First', tag: 'alpha', mins: 45, status: 'done', created: t0 },
+  tc: { id: 'tc', date: '2026-11-03', title: 'No tag', tag: '', mins: 0, status: 'todo', created: t0 + 9000 },
+  bad: { id: 'bad', date: 'nope', title: 'Broken date', tag: '', mins: 0, status: 'todo', created: t0 },
+}));
+const r = importLegacyJson(db, repo, legacy);
+assert.deepStrictEqual([r.found, r.imported, r.skipped], [true, 3, 1]);
+assert.ok(fs.existsSync(legacy + '.migrated') && !fs.existsSync(legacy));
